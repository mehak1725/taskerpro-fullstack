{
  "$schema": "https://railpack.com/schema.json",
  "provider": {
    "name": "node"
  },
  "steps": {
    "build": {
      "commands": [
        "pnpm install",
        "pnpm -r --if-present run build"
      ],
      "caches": [
        "pnpm"
      ]
    }
  },
  "deploy": {
    "startCommand": "node artifacts/api-server/railway-start.mjs",
    "variables": {
      "NODE_ENV": "production"
    }
  }
}
